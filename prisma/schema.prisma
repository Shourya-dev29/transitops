generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Users ───────────────────────────────────────────────────

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      String   // Validated by Zod: FLEET_MANAGER | DRIVER | SAFETY_OFFICER | FINANCIAL_ANALYST
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

// ── Vehicles ────────────────────────────────────────────────

model Vehicle {
  id                 Int      @id @default(autoincrement())
  registrationNumber String   @unique
  make               String
  model              String
  year               Int
  type               String   // Validated by Zod: Truck | Van | Bus | Sedan | SUV | Trailer
  status             String   @default("AVAILABLE") // AVAILABLE | ON_TRIP | IN_SHOP | RETIRED
  maxLoadCapacity    Float    // kg
  currentOdometer    Float    @default(0)
  acquisitionCost    Float    @default(0)
  region             String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  trips           Trip[]
  maintenanceLogs MaintenanceLog[]
  fuelLogs        FuelLog[]
  expenses        Expense[]

  @@index([status])
  @@index([type])
  @@index([region])
}

// ── Drivers ─────────────────────────────────────────────────

model Driver {
  id                Int      @id @default(autoincrement())
  name              String
  email             String   @unique
  phone             String   @default("")
  licenseNumber     String   @unique
  licenseExpiryDate DateTime
  status            String   @default("AVAILABLE") // AVAILABLE | ON_TRIP | OFF_DUTY | SUSPENDED | INACTIVE
  safetyScore       Float    @default(100)
  region            String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  trips Trip[]

  @@index([status])
  @@index([region])
}

// ── Trips ───────────────────────────────────────────────────

model Trip {
  id               Int       @id @default(autoincrement())
  vehicleId        Int
  driverId         Int
  origin           String
  destination      String
  cargoWeight      Float     // kg
  cargoDescription String    @default("")
  quotedRevenue    Float     // Set at creation, immutable once dispatched
  status           String    @default("DRAFT") // DRAFT | DISPATCHED | COMPLETED | CANCELLED
  scheduledDate    DateTime
  dispatchedAt     DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  finalOdometer    Float?
  fuelConsumed     Float?
  distance         Float?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  vehicle  Vehicle   @relation(fields: [vehicleId], references: [id])
  driver   Driver    @relation(fields: [driverId], references: [id])
  fuelLogs FuelLog[]

  @@index([status])
  @@index([vehicleId])
  @@index([driverId])
}

// ── Maintenance Logs ────────────────────────────────────────

model MaintenanceLog {
  id          Int       @id @default(autoincrement())
  vehicleId   Int
  type        String    // Validated by Zod from MAINTENANCE_TYPES
  description String    @default("")
  cost        Float     @default(0)
  startDate   DateTime  @default(now())
  endDate     DateTime?
  status      String    @default("OPEN") // OPEN | CLOSED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@index([status])
}

// ── Fuel Logs ───────────────────────────────────────────────

model FuelLog {
  id          Int      @id @default(autoincrement())
  vehicleId   Int
  tripId      Int?
  date        DateTime @default(now())
  quantity    Float    // liters
  costPerUnit Float
  totalCost   Float
  odometer    Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  trip    Trip?   @relation(fields: [tripId], references: [id])

  @@index([vehicleId])
  @@index([tripId])
}

// ── Expenses ────────────────────────────────────────────────

model Expense {
  id          Int      @id @default(autoincrement())
  vehicleId   Int?
  category    String   // Validated by Zod from EXPENSE_CATEGORIES
  description String   @default("")
  amount      Float
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@index([category])
}
